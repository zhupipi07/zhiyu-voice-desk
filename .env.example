# 北京地域。长期密钥只由本地服务读取。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
PORT=8765

# 仅 start-local.cmd 需要。填写装有 FunASR 的 Python 和本机 Paraformer 权重目录。
REVIEW_ASR_PYTHON=
REVIEW_ASR_MODEL=
# 网关端可选：server_vad_750、smart_turn_v2、server_vad（450 毫秒）或 local_vad。
# REVIEW_TURN_MODE=server_vad_750
# REVIEW_BATCH_MS=100
# REVIEW_LOCAL_SPEECH=1
# REVIEW_STRICT_AUDIO=1
# 比赛默认关闭预录短回应。仅在复现听感对照实验时显式设为 1。
REVIEW_LISTENER_CUE=0
